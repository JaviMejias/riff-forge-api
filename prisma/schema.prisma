generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/dev.db"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  songs            Song[]
  karaokes         Karaoke[]
  playlists        Playlist[]
  karaokePlaylists KaraokePlaylist[]
  customChords     CustomChord[]
  syncChanges      SyncChange[]
  syncOperations   ProcessedSyncOperation[]
  uiStorage        String? // Stores UI preferences as a JSON string
}

model Song {
  id               String     @id @default(uuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  artist           String?
  album            String?
  type             String? // 'gp' or 'text'
  cloudUrl         String? // Path to stored GP file if applicable
  textContent      String? // Text content for text tabs
  originalKey      String?
  tuning           String?
  strummingPattern String?
  capo             String?
  dateAdded        BigInt // Unix timestamp
  updatedAt        BigInt // Unix timestamp
  createdAt        BigInt      @default(0)
  deletedAt        BigInt?
  version          Int         @default(1)
  fileVersion      Int         @default(0)
  fileHash         String?
  fileSize         BigInt?
  fileMimeType     String?
  isPublic         Boolean    @default(false)
  playlists        Playlist[] @relation("PlaylistToSong")

  @@index([userId, deletedAt])
}

model Karaoke {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  artist           String?
  youtubeUrl       String?
  cloudUrl         String? // Path to stored MP3
  hasLocalAudio    Boolean           @default(false)
  pitchShift       Float? // In semitones
  textContent      String? // Synced lyrics
  dateAdded        BigInt
  updatedAt        BigInt
  createdAt        BigInt             @default(0)
  deletedAt        BigInt?
  version          Int                @default(1)
  fileVersion      Int                @default(0)
  fileHash         String?
  fileSize         BigInt?
  fileMimeType     String?
  isPublic         Boolean           @default(false)
  karaokePlaylists KaraokePlaylist[] @relation("KaraokePlaylistToKaraoke")

  @@index([userId, deletedAt])
}

model Playlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?
  version   Int      @default(1)
  songCloudIds String @default("[]")
  isPublic  Boolean  @default(false)
  songs     Song[]   @relation("PlaylistToSong")

  @@index([userId, deletedAt])
}

model KaraokePlaylist {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?
  version   Int       @default(1)
  karaokeCloudIds String @default("[]")
  isPublic  Boolean   @default(false)
  karaokes  Karaoke[] @relation("KaraokePlaylistToKaraoke")

  @@index([userId, deletedAt])
}

model CustomChord {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  root      String
  frets     String // JSON array as string or comma separated
  fingers   String // JSON array as string or comma separated
  baseFret  Int
  barres    String? // JSON array as string
  updatedAt BigInt
  createdAt BigInt  @default(0)
  deletedAt BigInt?
  version   Int     @default(1)
  isPublic  Boolean @default(false)

  @@index([userId, deletedAt])
}

model SyncChange {
  sequence   Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  version    Int
  action     String
  payload    String?
  createdAt  BigInt

  @@index([userId, sequence])
  @@index([userId, entityType, entityId])
}

model ProcessedSyncOperation {
  id          Int    @id @default(autoincrement())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String
  operationId String
  result      String
  createdAt   BigInt

  @@unique([userId, deviceId, operationId])
  @@index([userId, createdAt])
}

model CatalogTab {
  id        String   @id @default(uuid())
  artist    String
  title     String
  format    String   // gp3, gp4, gp5, gpx
  filePath  String   // Local path to the extracted file
  createdAt DateTime @default(now())

  @@index([artist, title])
}
